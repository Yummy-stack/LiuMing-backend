<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.liumingservices.mapper.EquipmentMapper">

    <resultMap id="BaseResultMap" type="com.liumingservices.entity.Equipment">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="category" property="category"/>
        <result column="main_info" property="mainInfo"/>
        <result column="length" property="length"/>
        <result column="size" property="size"/>
        <result column="file_path" property="filePath"/>
        <result column="source_url" property="sourceUrl"/>
    </resultMap>

    <select id="selectAllEquipments" resultType="com.liumingservices.entity.Equipment">
        select *
        from equipment;
    </select>


    <select id="selectListByLastId" resultMap="BaseResultMap">
        SELECT
        id,
        name,
        category,
        main_info,
        length,
        size,
        file_path,
        source_url
        FROM equipment
        <where>
            <if test="lastId != null and lastId > 0">
                AND id &gt; #{lastId}
            </if>
        </where>
        ORDER BY id ASC
        LIMIT #{pageSize}
    </select>

</mapper>
